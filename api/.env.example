# Local development: use the connection string of the Neon "dev" branch.
# Never put the production branch's string here. Production's string lives
# only in Render's environment settings.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"
# The seed deletes all data. It only runs if DATABASE_URL's host equals this value.
# Set it to your Neon DEV branch host. Never the production host.
SEED_ALLOWED_HOST="ep-xxxx.region.aws.neon.tech"

# Optional: the API's port (4000 if not set).
# PORT=4000

# Optional: only needed for "Continue with Google". Create an OAuth client in
# Google Cloud Console (APIs & Services → Credentials). The redirect URI goes
# through the web app's /api rewrite, so it uses port 3000, not 4000, and must
# match one of the client's "Authorised redirect URIs" exactly.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"