# Local development: use the connection string of the Neon "dev" branch.
# Never put the production branch's string here. Production's string lives
# only in Render's environment settings.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"
# The seed deletes all data. It only runs if DATABASE_URL's host equals this value.
# Set it to your Neon DEV branch host. Never the production host.
SEED_ALLOWED_HOST="ep-xxxx.region.aws.neon.tech"

# Optional: the API's port (4000 if not set).
# PORT=4000

# Optional: only needed for "Continue with Google". Create an OAuth client in
# Google Cloud Console (APIs & Services → Credentials). The redirect URI goes
# through the web app's /api rewrite, so it uses port 3000, not 4000, and must
# match one of the client's "Authorised redirect URIs" exactly.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"
# Payments (phase 5), Stripe TEST mode only: keys start with sk_test_ / whsec_.
# STRIPE_SECRET_KEY: Stripe Dashboard → Developers → API keys (test mode).
# STRIPE_WEBHOOK_SECRET: printed by `stripe listen` locally; in production it's
# the signing secret of the webhook endpoint you add in the Dashboard.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Where Stripe sends people back after paying (the web app, not the API)
WEB_URL="http://localhost:3000"

# Signs ticket QR codes (a JWT, decision 046). A long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a different value in production (Render).
TICKET_JWT_SECRET="replace-with-a-long-random-string"

# Email (phase 6), Resend's HTTP API. Optional: without a key, emails are
# skipped and logged ("skipped: disabled"); bookings work the same.
# RESEND_API_KEY: resend.com → API Keys, "Sending access". Use a different key
# on Render.
RESEND_API_KEY="re_..."
# No domain of our own yet, so Resend's test sender (decision 049)
EMAIL_FROM="Tixbook <onboarding@resend.dev>"
# Who may receive email (sandbox). Your own address, the one your Resend
# account uses. Comma-separated; empty = nobody; "*" = everyone (only once a
# domain is verified).
EMAIL_SANDBOX_ALLOWLIST="you@example.com"

# Redis on Upstash (phase 7): cache for the event pages, and rate-limit counters
# (decisions 061-065). Optional: without them the API keeps both in memory.
# Upstash console -> your database -> REST API: the REST URL and the normal
# token (not the rediss:// address, not the read-only token). The free plan has
# one database; dev and production share it safely (keys are prefixed per
# database host). Tests never use these: they always use memory.
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-rest-token"

# Optional, production only: how many proxies are in front of the API, so
# req.ip is the visitor's IP (rate limits). 0 locally. Set on Render from the
# "[proxy]" startup log lines (decision 064).
# TRUST_PROXY_HOPS=0

# Local development only, NEVER on Render: "true" lets requests whose
# connection comes from this machine (127.0.0.1 / ::1) skip the rate limits,
# so local logins and e2e runs aren't blocked. Missing or any other value →
# limits apply. On Render every request arrives on loopback from Render's
# proxy, so setting it there would switch every limit off (decision 067).
# The tests set it themselves (jest.setup-env.js).
RATE_LIMIT_EXEMPT_LOOPBACK=true
