// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ATTENDEE
  ORGANISER
}

// fieldName   Type   options
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events   Event[]
  bookings Booking[]
  sessions Session[]
}

enum EventFormat {
  IN_PERSON
  ONLINE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Event {
  id            String      @id @default(uuid())
  title         String
  description   String
  category      String
  format        EventFormat
  status        EventStatus @default(DRAFT)
  startsAt      DateTime
  endsAt        DateTime
  doorsAt       DateTime?
  timezone      String
  venueName     String?
  venueAddress  String?
  meetingLink   String?
  pricePence    Int
  seatLimit     Int
  coverImageUrl String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  organiserId String
  organiser   User   @relation(fields: [organiserId], references: [id])

  bookings Booking[]

  // Indexes for the list pages (decision 071). Postgres doesn't index
  // foreign keys on its own. Column order matters: equality first (status,
  // organiserId), then the column we sort or range on.
  // Public list: status = PUBLISHED, startsAt > now, ORDER BY startsAt, id
  @@index([status, startsAt, id])
  // Organiser's "My events": organiserId = me, ORDER BY startsAt DESC
  @@index([organiserId, startsAt])
}

enum BookingStatus {
  HELD
  CONFIRMED
  EXPIRED
  CANCELLED
  REFUNDED
}

model Booking {
  id                    String        @id @default(uuid())
  seats                 Int
  status                BookingStatus @default(HELD)
  unitPricePence        Int
  holdExpiresAt         DateTime?
  reference             String        @unique
  stripeSessionId       String?       @unique
  // The payment that paid for this booking (set by the Stripe webhook).
  // Refunds are made against it, so it's unique: one payment, one booking.
  stripePaymentIntentId String?       @unique
  idempotencyKey        String        @unique
  // When the ticket was scanned at the door; null = not checked in yet.
  // Set by one conditional update, so it can only be set once (decision 055).
  checkedInAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  // "My tickets": userId = me, ORDER BY createdAt DESC (also expireHolds by user)
  @@index([userId, createdAt])
  // Seats taken and the organiser dashboard: eventId IN (...) / = one event,
  // with a status filter (also the seat count inside the booking transaction)
  @@index([eventId, status])
}

// Stripe webhook events we have finished handling. Stripe may deliver the same
// event more than once; the id (evt_...) lets us skip copies (decision 042).
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model Session {
  // SHA-256 hash of the session token. The real token only lives in the user's cookie.
  id        String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
